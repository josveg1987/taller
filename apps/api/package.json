{
  "name": "@taller/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "migrate": "node-pg-migrate -m migrations --envPath ../../.env --verbose false",
    "crear-admin": "nest build && node dist/cli/crear-admin.js",
    "catalogo:generar": "node scripts/catalogo-desde-sii.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
